{
  "manifest_version": 3,
  "name": "Style Spy",
  "version": "1.0",
  "description": "Extract colors and fonts from any website, save as kits, and export CSS.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Style Spy"
  }
}